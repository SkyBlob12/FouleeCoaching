{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runningcoach",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "runningcoach",
      // remplacé par l'id réel après `wrangler d1 create runningcoach`
      "database_id": "c4e30fde-ed77-49c2-a727-a8418d3158a1",
      "migrations_dir": "migrations"
    }
  ],
  // IA du plan : Claude via le secret ANTHROPIC_API_KEY (modèle réglable ici)
  "vars": { "CLAUDE_MODEL": "claude-sonnet-5-5" },
  // purge du cache Strava > 7 jours
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
